# Une seule origine pour le navigateur : les pages ici, /api relayé vers l'API (API_URL, obligatoire).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_URL} {
			# Pendant qu'elle redémarre (à chaque mise à jour du site), l'API n'accepte pas de connexion : on réessaie
			# pendant 30 s au lieu de renvoyer tout de suite une erreur 502, la page met juste un peu plus à venir.
			lb_try_duration 30s
			lb_try_interval 500ms
			# L'hébergeur route sur le nom de l'API ; l'API retrouve l'adresse publique par X-Forwarded-Host.
			header_up Host {upstream_hostport}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * /srv
		# Routeur du front en mode historique. « / » sert index.html, l'accueil déjà rendu en HTML (docs/adr/0011) ;
		# toute autre page inconnue du disque renvoie app.html, la coquille vide, pour ne pas montrer l'accueil une fraction
		# de seconde avant la vraie page. « / » doit être nommé : try_files ne le prend pas pour un fichier.
		@accueil path /
		rewrite @accueil /index.html
		try_files {path} /app.html
		file_server
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			# Seuls les scripts de Jamii s'exécutent : aucun script en ligne, aucun script d'un autre site. Les images
			# viennent aussi des avatars GitHub et Google (https:) ; les appels audio et vidéo passent par blob: et l'API.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			# Caméra et micro pour les appels de Jamii seulement ; le reste est coupé.
			Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=()"
			Cross-Origin-Opener-Policy same-origin
			-Server
		}
		@fichiers path /assets/*
		header @fichiers Cache-Control "public, max-age=31536000, immutable"
	}
}
