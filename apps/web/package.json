{
  "name": "jamii-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:factice": "vite --mode factice",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "api:types": "openapi-typescript ../../contracts/socle.yaml -o src/api/generated/socle.ts && openapi-typescript ../../contracts/systalink.yaml -o src/api/generated/systalink.ts && openapi-typescript ../../contracts/vitrine.yaml -o src/api/generated/vitrine.ts && openapi-typescript ../../contracts/communautes.yaml -o src/api/generated/communautes.ts",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
