# Copier ce fichier en .env, puis remplir. Ne JAMAIS commiter .env.
# Toute nouvelle variable doit être ajoutée ici, avec un commentaire.

# --- Base de données (locale : voir docker-compose.yml) ---
POSTGRES_DB=jamii
POSTGRES_USER=jamii
POSTGRES_PASSWORD=jamii_dev_only
POSTGRES_PORT=5432
# Hôte de la base vu par l'API (apps/api lit POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD)
POSTGRES_HOST=localhost
# Chiffrement de la connexion de l'API : prefer en local, require (ou verify-full) en production
POSTGRES_SSLMODE=prefer
DATABASE_URL=postgresql://jamii:jamii_dev_only@localhost:5432/jamii

# --- Connexion GitHub (OAuth App : https://github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Dans l'OAuth App GitHub, « Authorization callback URL » = <adresse de l'API>/api/auth/github/retour
# (en local : http://localhost:8080/api/auth/github/retour). L'API la calcule elle-même.
# Génération du profil depuis GitHub (#19) : github, ou simule pour des données factices sans réseau
GITHUB_SOURCE=github
# Jeton GitHub SANS AUCUNE permission (fine-grained, accès « Public repositories »). Facultatif en local.
# Sans lui, GitHub limite à 60 requêtes par heure pour tout le serveur ; avec lui, 5 000.
GITHUB_TOKEN=

# --- Connexion par lien e-mail ---
# simule (n'envoie rien) pour l'instant ; l'adaptateur SMTP viendra avec le choix du service de messagerie
EMAIL_FOURNISSEUR=simule
# true en local pour voir le lien de connexion dans la console de l'API. Jamais en production.
EMAIL_AFFICHER_LIEN=true

# --- Service IA ---
# Fournisseur derrière l'interface FournisseurIA : simule (aucun appel réseau).
# yokk sera ajouté après le test de son API (docs/systalink-services.md).
IA_PROVIDER=simule
YOKK_API_KEY=
# Port d'écoute de services/ia (8000 par défaut). Si l'hébergeur impose PORT, PORT l'emporte.
IA_PORT=8000
# Secret partagé entre l'API et le service IA (16 caractères minimum, obligatoire).
# En production : une valeur aléatoire, par exemple `openssl rand -hex 32`.
IA_JETON_INTERNE=jeton_dev_only_a_remplacer
# Dernier rempart : nombre maximal de tâches IA acceptées par heure, tous utilisateurs confondus.
IA_LIMITE_PAR_HEURE=100

# --- Mise en ligne des projets (apps/api, module deploiement, #20) ---
# Domaines des services DataCloud, séparés par des virgules : une adresse sous ces domaines est classée
# « Hébergé sur Systalink ». À remplir au premier vrai déploiement. Vide : tout est classé « autre ».
DATACLOUD_DOMAINES=

# --- Mise en ligne des projets (apps/api, module deploiement, #20) ---
# Domaines des services DataCloud, séparés par des virgules : une adresse sous ces domaines est classée
# « Hébergé sur Systalink ». À remplir au premier vrai déploiement. Vide : tout est classé « autre ».
DATACLOUD_DOMAINES=

# --- Systalink (déploiement en un clic, à confirmer par #4) ---
SYSTALINK_API_KEY=

# --- URLs des applications en local ---
# Adresse du front : l'API y renvoie l'utilisateur après la connexion
WEB_URL=http://localhost:5173
API_URL=http://localhost:8080
# Port d'écoute de apps/api (8080 par défaut). Si l'hébergeur impose PORT, PORT l'emporte.
API_PORT=8080
IA_URL=http://localhost:8000
