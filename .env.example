# Copier ce fichier en .env, puis remplir. Ne JAMAIS commiter .env.
# Toute nouvelle variable doit être ajoutée ici, avec un commentaire.

# --- Base de données (locale : voir docker-compose.yml) ---
POSTGRES_DB=jamii
POSTGRES_USER=jamii
POSTGRES_PASSWORD=jamii_dev_only
POSTGRES_PORT=5432
# Hôte de la base vu par l'API (apps/api lit POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD)
POSTGRES_HOST=localhost
# Chiffrement de la connexion de l'API : prefer en local, require (ou verify-full) en production
POSTGRES_SSLMODE=prefer
DATABASE_URL=postgresql://jamii:jamii_dev_only@localhost:5432/jamii

# --- Connexion GitHub (OAuth App : https://github.com/settings/developers) ---
# OAuth App « jamii » de l'équipe (Client ID public). Le secret se demande en privé au chef de projet :
# jamais dans GitHub (dépôt, issue, PR, commit). Sans secret, seule la connexion par e-mail marche.
GITHUB_CLIENT_ID=Ov23liMf8uR5ILsxF6mi
GITHUB_CLIENT_SECRET=
# Adresse de retour enregistrée dans l'OAuth App : http://localhost:5173/api/auth/github/retour
# Ouvrir donc le site sur http://localhost:5173 (le proxy de Vite), pas sur 127.0.0.1 ni sur :8080.

# --- Connexion Google (#260, facultative) ---
# Client OAuth « Application Web » (console.cloud.google.com), écran de consentement « En production » avec seulement
# profile et email. Adresses de retour : http://localhost:5173/api/auth/google/retour et
# https://<domaine du site>/api/auth/google/retour. Le secret se donne en privé, jamais dans GitHub.
# Vides : le bouton « Continuer avec Google » n'apparaît pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Génération du profil depuis GitHub (#19) : github, ou simule pour des données factices sans réseau
GITHUB_SOURCE=github
# Jeton GitHub SANS AUCUNE permission (fine-grained, accès « Public repositories »). Facultatif en local.
# Sans lui, GitHub limite à 60 requêtes par heure pour tout le serveur ; avec lui, 5 000.
GITHUB_TOKEN=

# Cookie de session « Secure » : true partout (par défaut). false SEULEMENT en local, pour se connecter avec Safari
# sur http://localhost (Safari refuse un cookie Secure sans HTTPS). Jamais false en production.
SESSION_COOKIE_SECURE=true

# --- Connexion par lien e-mail ---
# simule (n'envoie rien, en local) ou brevo (production : 300 e-mails par jour sans frais, https://www.brevo.com)
EMAIL_FOURNISSEUR=simule
# Avec brevo : la clé API (Brevo > SMTP & API > Clés API) et une adresse d'expéditeur vérifiée chez Brevo
BREVO_API_KEY=
EMAIL_EXPEDITEUR=
EMAIL_NOM_EXPEDITEUR=Jamii
# true en local pour voir le lien de connexion dans la console de l'API. Jamais en production.
EMAIL_AFFICHER_LIEN=true

# --- Service IA ---
# Fournisseur derrière l'interface FournisseurIA : simule (aucun appel réseau).
# yokk sera ajouté après le test de son API (docs/systalink-services.md).
IA_PROVIDER=simule
# Avec IA_PROVIDER=compatible_openai : toute API au format OpenAI (DeepSeek, OpenAI, Mistral…)
#   DeepSeek : IA_URL_FOURNISSEUR=https://api.deepseek.com   IA_MODELE=deepseek-chat
#   OpenAI   : IA_URL_FOURNISSEUR=https://api.openai.com/v1  IA_MODELE=<un modèle OpenAI>
# Vraie IA en local : IA_PROVIDER=compatible_openai, IA_CLE=<clé DeepSeek> et, plus bas, IA_FOURNISSEUR=service.
IA_URL_FOURNISSEUR=https://api.deepseek.com
IA_MODELE=deepseek-chat
IA_CLE=
# Plafond de jetons par jour (UTC). Au-delà, repli sans IA. 0 = pas de plafond.
IA_BUDGET_JOUR=200000
# Chemin du catalogue Systalink (vide = services/ia/catalogue-systalink.yaml)
IA_CATALOGUE=
YOKK_API_KEY=
# Port d'écoute de services/ia (8000 par défaut). Si l'hébergeur impose PORT, PORT l'emporte.
IA_PORT=8000
# Secret partagé entre l'API et le service IA (16 caractères minimum, obligatoire).
# En production : une valeur aléatoire, par exemple `openssl rand -hex 32`.
IA_JETON_INTERNE=jeton_dev_only_a_remplacer
# Dernier rempart : nombre maximal de tâches IA acceptées par heure, tous utilisateurs confondus.
IA_LIMITE_PAR_HEURE=100

# --- Mise en ligne des projets (apps/api, module deploiement, #20) ---
# Domaines des services DataCloud, séparés par des virgules : une adresse sous ces domaines est classée
# « Hébergé sur Systalink ». À remplir au premier vrai déploiement. Vide : tout est classé « autre ».
DATACLOUD_DOMAINES=

# --- Systalink (déploiement en un clic, à confirmer par #4) ---
SYSTALINK_API_KEY=
# Accès aux clients suivis (logins GitHub ou e-mails, séparés par des virgules), en plus des admins
SYSTALINK_ACCES=
# Webhook signé vers l'outil de suivi de Systalink (https). Vide : rien n'est envoyé. Secret : 16 caractères au moins
SYSTALINK_WEBHOOK_URL=
SYSTALINK_WEBHOOK_SECRET=

# --- URLs des applications en local ---
# Adresse du front : l'API y renvoie l'utilisateur après la connexion
WEB_URL=http://localhost:5173
API_URL=http://localhost:8080
# Port d'écoute de apps/api (8080 par défaut). Si l'hébergeur impose PORT, PORT l'emporte.
API_PORT=8080
IA_URL=http://localhost:8000
# Comment l'API obtient les plans : simule (sans réseau, par défaut) ou service (le service IA ci-dessus, avec IA_JETON_INTERNE)
IA_FOURNISSEUR=simule

# Appels vocaux et vidéo des salons (#155) : l'adresse d'un serveur Jitsi (meet.jit.si par défaut, ou le nôtre)
APPELS_URL=https://meet.jit.si

# Appels des discussions privées (#157), en WebRTC dans Jamii. STUN : pour trouver son adresse publique.
# TURN : notre relais coturn (deploiement/turnserver.conf), pour les réseaux qui bloquent la connexion directe.
# TURN_SECRET est le même que `static-auth-secret` de coturn ; l'API en tire des identifiants valables 4 h.
# Vides en local : STUN seulement, les appels passent entre deux onglets ou deux machines du même réseau.
# Générer un secret : openssl rand -hex 32
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=

# Le paiement des jalons d'une mission : declares (v1, Jamii n'encaisse rien, chacun déclare).
PAIEMENTS=declares

# Le lien du produit d'un rendu de hackathon : aucune (pas encore vérifié) ou simulee (local et tests).
VERIFICATION_LIEN=aucune

# Dépôt Git de chaque tour de cercle : aucun (par défaut, les tours n'ont pas de dépôt) ou github.
DEPOT_CODE=aucun
# Avec DEPOT_CODE=github : l'organisation GitHub qui reçoit les dépôts, et un jeton qui peut y créer des dépôts et
# inviter des membres (jeton fin, « Administration » et « Contents » en écriture sur l'organisation). Jamais commité.
GITHUB_DEPOTS_ORGANISATION=
GITHUB_DEPOTS_JETON=
# true : dépôts privés. false (par défaut) : publics, comme le projet dans la vitrine.
GITHUB_DEPOTS_PRIVES=false
